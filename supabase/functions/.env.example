# Edge Function secrets. Copy to supabase/functions/.env for `supabase functions serve`
# and set in production with `supabase secrets set --env-file ...`. Never commit real values.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
CRON_SECRET=generate-a-long-random-string
# Single-line JSON of a Firebase service account with the Firebase Cloud Messaging API role.
FCM_SERVICE_ACCOUNT_JSON={"project_id":"your-project","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# The one web origin allowed to call the payment functions (mobile apps are unaffected); "*" only for local development.
CORS_ALLOWED_ORIGIN=*
